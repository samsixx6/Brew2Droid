<?xml version="1.0" encoding="utf-8"?>
<!-- Menus Android nativos; a NativeActivity preserva a execução e apresentação do jogo. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.VIBRATE" />

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <!-- Uma coleção de ROMs mora fora do diretório do aplicativo, e desde o Android 11 lê-la
         exige o "acesso a todos os arquivos". Ele não é concedido na instalação: o usuário o
         dá em Ajustes › Aplicativos › Zeebx. Sem ele o Zeebx só enxerga a própria pasta. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />

    <!-- `appCategory="game"` não é enfeite de vitrine: é o que **mantém o travamento de
         orientação valendo**. A partir do Android 16, num alvo 36 ou maior, o sistema passa a
         ignorar `screenOrientation`, `resizeableActivity` e as razões de aspecto em telas com
         600dp ou mais de menor lado — tablet, dobrável, desktop —, e o Android 17 tira até a
         opção de recusar. Jogos são a exceção que sobrou, e um emulador de console é um jogo.
         O perfil handset também mantém a categoria ao mirar a API 37. -->
    <application
        android:label="Brew2Droid"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:appCategory="game"
        android:hasCode="true"
        android:requestLegacyExternalStorage="true">
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTop" android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".SettingsActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".GameSettingsActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".ProfilesActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".ProfileSettingsActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".ButtonLayoutActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".ButtonMappingActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".FolderPickerActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity
            android:name=".GameActivity"
            android:enableOnBackInvokedCallback="true"
            android:exported="true"
            android:screenOrientation="portrait"
            android:resizeableActivity="false"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|density|uiMode">
            <meta-data
                android:name="android.app.lib_name"
                android:value="zeebx_android" />
        </activity>
    </application>

</manifest>
